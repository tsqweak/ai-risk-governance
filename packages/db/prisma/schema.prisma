}

model AuditPackage {
  id            String                 @id @default(cuid())
  packageId     String                 @unique
  title         String
  scope         String
  packageType   String
  owner         String
  aiSystemId    String?
  generatedDate DateTime               @default(now())
  aiSystem      AiSystem?              @relation(fields: [aiSystemId], references: [id], onDelete: SetNull)
  evidenceLinks AuditPackageEvidence[]
}

model AuditPackageEvidence {
  id               String         @id @default(cuid())
  auditPackageId   String
  evidenceObjectId String
  auditPackage     AuditPackage   @relation(fields: [auditPackageId], references: [id], onDelete: Cascade)
  evidenceObject   EvidenceObject @relation(fields: [evidenceObjectId], references: [id], onDelete: Cascade)

  @@unique([auditPackageId, evidenceObjectId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  aiSystemId String
  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  eventType  String
  summary    String
  actor      String
  createdAt  DateTime @default(now())
}

model ControlTest {
  id                           String          @id @default(cuid())
  testId                       String          @unique
  title                        String
  description                  String
  traditionalGovernanceConcept String
  aiGovernanceInterpretation   String
  whyItMatters                 String
  severityIfFailed             FindingSeverity
  enabled                      Boolean         @default(true)
  testRuns                     TestRun[]
  findings                     Finding[]
}

model TestRun {
  id                String      @id @default(cuid())
  controlTestId     String
  aiSystemId        String
  executionDate     DateTime    @default(now())
  result            TestResult
  resultDetails     String
  evidenceReference String
  controlTest       ControlTest @relation(fields: [controlTestId], references: [id], onDelete: Cascade)
  aiSystem          AiSystem    @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
}

model Finding {
  id                    String            @id @default(cuid())
  findingId             String            @unique
  aiSystemId            String
  controlTestId         String
  title                 String
  description           String
  severity              FindingSeverity
  status                FindingStatus
  createdDate           DateTime          @default(now())
  remediationTargetDate DateTime
  owner                 String
  aiSystem              AiSystem          @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  controlTest           ControlTest       @relation(fields: [controlTestId], references: [id], onDelete: Cascade)
  exceptions            Exception[]
  aiRiskLinks           AiRiskFinding[]
}

model Exception {
  id             String   @id @default(cuid())
  exceptionId    String   @unique
  findingId      String
  rationale      String
  approvedBy     String
  approvalDate   DateTime
  expirationDate DateTime
  finding        Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}
