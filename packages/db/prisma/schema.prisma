}

enum DeploymentDriftType {
  BASELINE_RECORDED
  IMAGE_CHANGED
  CONTAINER_CHANGED
  LOGGING_DISABLED
  HEALTH_STATUS_DEGRADED
  SOURCE_UNAVAILABLE
}

model Persona {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  role        String
  description String
  createdAt   DateTime @default(now())
}

model RepositoryDiscovery {
  id                   String                    @id @default(cuid())
  name                 String
  description          String
  location             String
  repositoryType       RepositoryType
  reviewStatus         RepositoryReviewStatus
  suggestedSystemType  String
  suggestedAgenticLevel Int
  suggestedAuthorityLevel Int
  suggestedLifecycleStage LifecycleStatus
  suggestedJurisdictionsJson String
  suggestedRiskDomainsJson String
  suggestedControlsJson String
  suggestedRisksJson   String
  rationale            String
  reviewer             String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  components           RepositoryComponent[]
  evidenceSources      RepositoryEvidenceSource[]
  governanceManifest   GovernanceManifest?
  onboardingFindings   RepositoryOnboardingFinding[]
}

model RepositoryComponent {
  id                    String                  @id @default(cuid())
  repositoryDiscoveryId String
  repositoryDiscovery   RepositoryDiscovery     @relation(fields: [repositoryDiscoveryId], references: [id], onDelete: Cascade)
  componentType         DiscoveredComponentType
  name                  String
  location              String
  rationale             String
}

model RepositoryEvidenceSource {
  id                    String                       @id @default(cuid())
  repositoryDiscoveryId String
  repositoryDiscovery   RepositoryDiscovery          @relation(fields: [repositoryDiscoveryId], references: [id], onDelete: Cascade)
  sourceType            DiscoveredEvidenceSourceType
  title                 String
  location              String
  collectionMethod      String
  validationMethod      String
  automationLevel       String
  rationale             String
}

model GovernanceManifest {
  id                    String                   @id @default(cuid())
  manifestId            String                   @unique
  repositoryDiscoveryId String                   @unique
  repositoryDiscovery   RepositoryDiscovery      @relation(fields: [repositoryDiscoveryId], references: [id], onDelete: Cascade)
  fileName              String
  location              String
  validationStatus      ManifestValidationStatus
  systemName            String
  businessOwner         String
  riskOwner             String
  lifecycleStage        LifecycleStatus
  aiType                String
  riskTier              RiskLevel
  evidenceSourceCount   Int
  manifestYaml          String
  validationMessagesJson String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model RepositoryOnboardingFinding {
  id                    String              @id @default(cuid())
  findingId             String
  repositoryDiscoveryId String
  repositoryDiscovery   RepositoryDiscovery @relation(fields: [repositoryDiscoveryId], references: [id], onDelete: Cascade)
  title                 String
  severity              FindingSeverity
  status                FindingStatus
  rationale             String
  createdAt             DateTime            @default(now())

  @@index([findingId])
}

model AiSystem {
  id                           String              @id @default(cuid())
  slug                         String              @unique
  name                         String
  description                  String
  businessPurpose              String
  lifecycleStatus              LifecycleStatus
  environment                  SystemEnvironment
  businessOwner                String
  technologyOwner              String
  riskOwner                    String
  executiveSponsor             String
  customerFacing               Boolean
  internalUserFacing           Boolean
  personalData                 Boolean
  materialBusinessProcess      Boolean
  regulatedActivity            Boolean
  autonomousAction             Boolean
  financialTransaction         Boolean
  externalThirdPartyDependency Boolean
  dataClassification           DataClassification
  jurisdictionsJson            String
  useCaseType                  String
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  lastReviewDate               DateTime
  nextReviewDate               DateTime
  assessment                   RiskAssessment?
  evidenceItems                EvidenceItem[]
  systemControls               SystemControl[]
  auditEvents                  AuditEvent[]
  components                   AiSystemComponent[]
  regulatoryControls           AiSystemRegulatoryControl[]
  testRuns                     TestRun[]
  findings                     Finding[]
  evidenceObjects              EvidenceObject[]
  evidenceHealth               EvidenceHealth[]
  auditPackages                AuditPackage[]
  aiModels                     AiModel[]
  promptAssets                 PromptAsset[]
  agents                       Agent[]
  authorityAssignment          AiSystemAuthority?
  toolPermissions              ToolPermission[]
  humanOversight               HumanOversight?
  governedTools                GovernedTool[]
  agentActions                 AgentAction[]
  executionLogs                ExecutionLog[]
  killSwitch                   KillSwitch?
  lifecycleRecords             AiLifecycle[]
  lifecycleApprovals           AiLifecycleApproval[]
  aiRisks                      AiRisk[]
  controlImplementations       ControlImplementation[]
  assets                       Asset[]
  repositoryConnections        RepositoryConnection[]
  selectedGitHubRepositories    GitHubRepositoryDiscovery[]
  logSources                   LogSource[]
  portainerConnections         PortainerConnection[]
  supabaseConnections          SupabaseConnection[]
  mcpConnections               McpConnection[]
  notionConnections            NotionConnection[]
  secretsConnections           SecretsConnection[]
  assetDiscoveryRuns           AssetDiscoveryRun[]
}

model GitHubRepositoryDiscovery {
  id                    String    @id @default(cuid())
  repositoryId          String    @unique
  owner                 String
  name                  String
  fullName              String
  repositoryUrl         String
  defaultBranch         String
  description           String
  isPrivate             Boolean
  isArchived            Boolean
  lastPushedAt          DateTime?
  discoveredAt          DateTime  @default(now())
  selectedForAiSystemId String?
  selectedForAiSystem   AiSystem? @relation(fields: [selectedForAiSystemId], references: [id], onDelete: SetNull)

  @@index([owner])
  @@index([selectedForAiSystemId])
}

model RepositoryConnection {
  id                String                     @id @default(cuid())
  repositoryId      String                     @unique
  aiSystemId        String
  aiSystem          AiSystem                   @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  repositoryUrl     String
  branch            String
  status            RepositoryConnectionStatus
  lastScan          DateTime?
  evidenceArtifacts EvidenceArtifact[]
  driftEvents       ArtifactDriftEvent[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([aiSystemId])
}

model Asset {
  id              String             @id @default(cuid())
  assetId         String             @unique
  aiSystemId      String
  aiSystem        AiSystem           @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  assetType       AssetType
  name            String
  owner           String
  criticality     AssetCriticality
  status          AssetStatus
  description     String
  evidenceSources EvidenceSource[]
  discoveryFindings AssetDiscoveryFinding[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([aiSystemId])
}

model AssetDiscoveryRun {
  id                    String                    @id @default(cuid())
  runId                 String                    @unique
  aiSystemId            String
  aiSystem              AiSystem                  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  status                AssetDiscoveryRunStatus
  startedAt             DateTime
  completedAt           DateTime
  knownAssetCount       Int
  discoveredAssetCount  Int
  unknownAssetCount     Int
  untrackedAssetCount   Int
  orphanedAssetCount    Int
  missingAssetCount     Int
  inventoryCompleteness Int
  summary               String
  comparisonSummary     String
  recommendedAction     String
  sources               AssetDiscoverySource[]
  findings              AssetDiscoveryFinding[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([aiSystemId])
  @@index([status])
}

model AssetDiscoverySource {
  id                    String                   @id @default(cuid())
  sourceId              String                   @unique
  runId                 String
  run                   AssetDiscoveryRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceType            AssetDiscoverySourceType
  name                  String
  location              String
  inspectedAt           DateTime
  inspectionMethod      String
  evidenceSummary       String
  discoveredAssetCount  Int
  expectedAssetCount    Int
  unknownAssetCount     Int
  missingAssetCount     Int
  confidence            Int
  findings              AssetDiscoveryFinding[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([runId])
  @@index([sourceType])
}

model AssetDiscoveryFinding {
  id                    String                       @id @default(cuid())
  findingId             String                       @unique
  runId                 String
  run                   AssetDiscoveryRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId              String?
  discoverySource       AssetDiscoverySource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  assetId               String?
  asset                 Asset?                       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  findingType           AssetDiscoveryFindingType
  disposition           AssetDiscoveryDisposition
  assetType             AssetDiscoveryAssetType
  assetName             String
  declared              Boolean
  discovered            Boolean
  tracked               Boolean
  orphaned              Boolean
  evidenceSourceMissing Boolean
  sourceLabel           String
  sourceFile            String
  sourceAsset           String
  evidence              String
  discoveryRule         String
  reason                String
  confidence            Int
  confidenceLevel       AssetDiscoveryConfidenceLevel
  validationStatus      AssetDiscoveryValidationStatus
  validationExplanation String
  invalidReason         String
  severity              FindingSeverity
  status                AssetDiscoveryFindingStatus
  recommendedAction     String
  relatedControlsJson   String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([runId])
  @@index([sourceId])
  @@index([assetId])
  @@index([findingType])
  @@index([disposition])
  @@index([status])
}

model EvidenceSource {
  id                     String                    @id @default(cuid())
  sourceId               String                    @unique
  assetId                String
  asset                  Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sourceType             EvidenceSourceType
  collectionMethod       String
  validationMethod       String
  automationLevel        AutomationLevel
  collectionStatus       EvidenceCollectionStatus
  lastCollectedAt        DateTime?
  lastValidatedAt        DateTime?
  freshnessStatus        FreshnessStatus
  connectorHealth        AuditStatus
  evidenceLocation       String
  governanceValue        String
  artifacts              EvidenceArtifact[]
  logSources             LogSource[]
  deploymentArtifacts    DeploymentEvidenceArtifact[]
  supabaseArtifacts       SupabaseEvidenceArtifact[]
  mcpArtifacts            McpEvidenceArtifact[]
  notionArtifacts         NotionEvidenceArtifact[]
  secretArtifacts          SecretEvidenceArtifact[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([assetId])
}

model LogSource {
  id                 String                    @id @default(cuid())
  logSourceId        String                    @unique
  aiSystemId         String
  aiSystem           AiSystem                  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  evidenceSourceId   String?
  evidenceSource     EvidenceSource?           @relation(fields: [evidenceSourceId], references: [id], onDelete: SetNull)
  name               String
  location           String
  type               LogSourceType
  status             LogSourceStatus
  retentionPeriod    String
  lastCollected      DateTime?
  sourceGap          String
  runtimeArtifacts   RuntimeEvidenceArtifact[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([aiSystemId])
  @@index([evidenceSourceId])
  @@index([type])
  @@index([status])
}

model RuntimeEvidenceArtifact {
  id                  String                  @id @default(cuid())
  artifactId          String                  @unique
  logSourceId         String
  logSource           LogSource               @relation(fields: [logSourceId], references: [id], onDelete: Cascade)
  eventType           LogSourceType
  evidenceType        RuntimeEvidenceType
  eventTimestamp      DateTime
  correlationId       String
  hash                String
  validationStatus    EvidenceValidationValue
  collectionDate      DateTime
  sourceRecordId      String
  relatedControlId    String
  sanitizedEvidence   String
  evidenceSummary     String
  collectionReason    String
  retentionPolicy     String
  evidenceHealth      RuntimeEvidenceHealth
  retentionValid      Boolean
  collectionCurrent   Boolean
  collectionRationale String
  assuranceSummary    String
  failureCondition    String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([logSourceId])
  @@index([relatedControlId])
  @@index([validationStatus])
}

model PortainerConnection {
  id                  String                    @id @default(cuid())
  connectionId        String                    @unique
  aiSystemId          String
  aiSystem            AiSystem                  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  endpoint            String
  environment         String
  status              PortainerConnectionStatus
  lastScan            DateTime?
  sourceGap           String
  deploymentArtifacts DeploymentEvidenceArtifact[]
  driftEvents         DeploymentDriftEvent[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([aiSystemId])
  @@index([status])
}

model DeploymentEvidenceArtifact {
  id                    String                    @id @default(cuid())
  artifactId            String                    @unique
  portainerConnectionId String
  portainerConnection   PortainerConnection       @relation(fields: [portainerConnectionId], references: [id], onDelete: Cascade)
  evidenceSourceId      String?
  evidenceSource        EvidenceSource?           @relation(fields: [evidenceSourceId], references: [id], onDelete: SetNull)
  deploymentId          String
  containerName         String
  imageName             String
  imageTag              String
  deploymentTimestamp   DateTime?
  collectionTimestamp   DateTime
  hash                  String
  validationStatus      EvidenceValidationValue
  restartCount          Int?
  healthStatus          String
  loggingEnabled        Boolean?
  runtimeConfiguration  String
  collectionMethod      String
  provenance            String
  relatedControlsJson   String
  evidenceSummary       String
  collectionReason      String
  assuranceSummary      String
  failureCondition      String
  sourceGap             String
  evidenceHealth        DeploymentEvidenceHealth
  driftEvents           DeploymentDriftEvent[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([portainerConnectionId])
  @@index([evidenceSourceId])
  @@index([validationStatus])
  @@index([evidenceHealth])
}

model SupabaseConnection {
  id                  String                    @id @default(cuid())
  connectionId        String                    @unique
  aiSystemId          String
  aiSystem            AiSystem                  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  projectId           String
  environment         String
  status              SupabaseConnectionStatus
  lastScan            DateTime?
  sourceGap           String
  evidenceArtifacts   SupabaseEvidenceArtifact[]
  snapshots           SupabaseEvidenceSnapshot[]
  driftEvents         SupabaseDriftEvent[]
  controlValidations  SupabaseControlValidation[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([aiSystemId])
  @@index([status])
}

model SupabaseEvidenceArtifact {
  id                    String                    @id @default(cuid())
  artifactId            String                    @unique
  supabaseConnectionId  String
  supabaseConnection    SupabaseConnection        @relation(fields: [supabaseConnectionId], references: [id], onDelete: Cascade)
  evidenceSourceId      String?
  evidenceSource        EvidenceSource?           @relation(fields: [evidenceSourceId], references: [id], onDelete: SetNull)
  evidenceType          SupabaseEvidenceType
  title                 String
  collectionTimestamp   DateTime
  source                String
  hash                  String
  validationStatus      EvidenceValidationValue
  evidenceHealth        SupabaseEvidenceHealth
  schemaInventory       String
  tableInventory        String
  rlsStatus             String
  enabledPolicies       String
  databaseRoles         String
  auditCapability       String
  collectionMethod      String
  provenance            String
  relatedControlsJson   String
  evidenceSummary       String
  collectionReason      String
  assuranceSummary      String
  failureCondition      String
  sourceGap             String
  controlValidations    SupabaseControlValidation[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([supabaseConnectionId])
  @@index([evidenceSourceId])
  @@index([validationStatus])
  @@index([evidenceHealth])
}

model SupabaseEvidenceSnapshot {
  id                   String             @id @default(cuid())
  snapshotId           String             @unique
  supabaseConnectionId String
  supabaseConnection   SupabaseConnection @relation(fields: [supabaseConnectionId], references: [id], onDelete: Cascade)
  collectionTimestamp  DateTime
  databaseVersion      String
  hash                 String
  schemaInventory      String
  tableInventory       String
  rlsInventory         String
  policyInventory      String
  roleInventory        String
  extensionInventory   String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([supabaseConnectionId])
  @@index([collectionTimestamp])
  @@index([hash])
}

model SupabaseDriftEvent {
  id                   String              @id @default(cuid())
  driftId              String              @unique
  supabaseConnectionId String
  supabaseConnection   SupabaseConnection  @relation(fields: [supabaseConnectionId], references: [id], onDelete: Cascade)
  previousSnapshotId   String
  currentSnapshotId    String
  eventType            SupabaseDriftType
  previousValue        String
  currentValue         String
  detectedAt           DateTime
  changeSummary        String
  status               AssuranceRuleStatus
  controlImpact        String
  recommendedAction    String
  createdAt            DateTime            @default(now())
