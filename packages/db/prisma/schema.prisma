generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum LifecycleStatus {
  PROPOSED
  DEVELOPMENT
  TESTING
  PILOT
  PRODUCTION
  RETIRED
}

enum SystemEnvironment {
  SANDBOX
  NON_PRODUCTION
  PRODUCTION
}

